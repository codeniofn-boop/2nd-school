        {
          "kind": "extracurricular",
          "title": "Volunteer at a museum, archive, or heritage fair",
          "detail": "Local museums, archives, and heritage fairs regularly take student volunteers. Cataloguing collections, guiding visitors, or helping run a fair shows sustained engagement with the past beyond the classroom.",
          "sortOrder": 0
        },
        {
          "kind": "extracurricular",
          "title": "Enter a history essay contest",
          "detail": "Essay competitions run by universities, historical societies, and remembrance organizations reward exactly the research and writing skills history programs screen for, and a placement is a strong line on any application.",
          "sortOrder": 1
        },
        {
          "kind": "extracurricular",
          "title": "Take on a genealogy or local-history project",
          "detail": "Tracing a family tree or documenting a local building, event, or community teaches primary-source research with censuses, newspapers, and archival records — and produces a concrete project you can describe in applications.",
          "sortOrder": 2
        }
      ]
    }
