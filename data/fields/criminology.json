          "sortOrder": 1
        },
        {
          "kind": "extracurricular",
          "title": "Hold a part-time job with real responsibility",
          "detail": "Customer-facing work such as retail, food service, or camp leadership demonstrates reliability and the calm de-escalation skills that justice-related programs and future employers look for.",
          "sortOrder": 2
        }
      ]
    }
