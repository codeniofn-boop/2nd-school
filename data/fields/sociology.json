{
  "categories": [
    {
      "slug": "sociology",
      "name": "Sociology",
      "aliases": [
        "soc",
        "social sciences",
        "society and culture",
        "social justice"
      ],
      "description": "Sociology programs examining how societies, institutions, and social inequalities work, combining social theory with research methods and leading toward careers in social policy, law, community work, and research.",
      "tips": [
        {
          "kind": "extracurricular",
          "title": "Volunteer in your community",
          "detail": "Sustained volunteering with community organizations — food banks, shelters, settlement agencies, seniors' programs — shows genuine engagement with the social issues sociology studies and gives you concrete experiences to write about in applications.",
          "sortOrder": 0
        },
        {
          "kind": "extracurricular",
          "title": "Join a social-justice or equity club",
          "detail": "Organizing or leading within a social-justice, equity, or human-rights club at school demonstrates sustained commitment to understanding and addressing inequality — exactly the kind of engagement sociology programs value.",
          "sortOrder": 1
        },
        {
          "kind": "extracurricular",
          "title": "Do a research-style project on a social issue",
          "detail": "A survey, interview, or data project on a social issue in your school or neighbourhood — carefully designed and written up — previews the research methods at the heart of a sociology degree and stands out on supplementary applications.",
          "sortOrder": 2
        }
      ]
    }
  ],
